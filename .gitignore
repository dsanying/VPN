# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
dist-package/
release/
*.local
*.asar

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs (anchor to repo root so 源码目录 src/.../components/logs/ 不被误忽略)
*.log
/[Ll]og/
/[Ll]ogs/

# Test files
samples/
*.test.exe

# Development scripts (keep in repo but ignore generated)
scripts/*.exe

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp

# Local test files (may contain private config)
test-*.json

# ── Sensitive runtime data (NEVER commit) ──────────────────────────────
# User proxy configs & node lists (stored in OS userData dir at runtime,
# but guard against any accidental copies landing in the repo)
config.json
singbox_config.json
singbox_config.json.bak
sing-box.exe.bak
root.json
sub-store.json
sing-box.bak
cache.db
singbox.log
*.bak

# Subscription cache
subscriptions/
subscription-cache/

# Any local override configs
local.config.*
*.local.json

# sing-box 内核二进制（由 npm run fetch:core 按 core-manifest.json 版本+coreSha256 下载官方 release，打包时随 resources 打入；每平台 66–74MB、4 平台 ~276MB 不入库防仓库膨胀，CI 现拉现打）
resources/*/sing-box
resources/*/sing-box.exe

# NaiveProxy 核心库（由 npm run fetch:cronet 下载，打包时随 resources 打入；体积大不入库）
resources/*/libcronet.*

# sing-box 官方面板静态资源（由 npm run fetch:dashboard 下载 gh-pages 构建，打包时随 resources 打入；构建产物不入库，CI 现拉现打）
resources/dashboard/

# 提权 helper 二进制（macOS com.dsanying.shadowvpn.helper / Windows com.dsanying.shadowvpn.helper.exe，由 npm run build:helper 交叉编译；构建产物不入库，CI 现编现打）
resources/*/com.dsanying.shadowvpn.helper
resources/*/com.dsanying.shadowvpn.helper.exe
# helper-win/ 本地 go build 误产的二进制（构建应输出到 resources/win/，源目录的 .exe 不入库）
helper-win/*.exe

# ── 误落到 repo 根的产物 / 运行时临时文件（不入库；gitignore 不支持行内注释，注释独立成行）──
# 运行时 PID 文件（py.pid / sb2.pid 等）
*.pid
# 临时 sing-box 测试配置 / rule set 测试文件
/cfg2.json
/rsf.json
# 误编译到根目录的产物（源码在 src/main/services/*.ts；jest.config.js 等合法根 .js 不受影响）
/HelperManager.js
/ProxyManager.js

# ── 本地设计文档（含 Obsidian wikilink / 内部过程，本地保留不入 PR）──────
docs/design/
# 本地真机验证清单（同 design 性质：含内部过程，不入 PR）
docs/validation-checklist.md

# tsc 增量编译产物（防 tsc 增量后再次变 untracked 误提交）
*.tsbuildinfo

# 构建时注入的构建日期常量（scripts/gen-build-info.js 生成；每次 build 覆写，不入库）
src/shared/build-info.ts

# ── 误落到 repo 根的本地文件（Obsidian 临时画布 / daily note / 误编译 helper 产物）──
/Untitled.canvas
/2026-06-13.md
/helper/shadowvpn-helper-mac

# Linux 提权 helper 构建产物
resources/linux/shadowvpn-helper-linux
resources/mac-*/shadowvpn-network-events

# 前端浏览器检查产物（包含构建、截图及 trace）
/web/.playwright/
# Playwright 截图门禁的输出目录
/web/test-results/

# Official compatibility cores fetched with pinned hashes
resources/*/xray
resources/*/xray.exe
resources/*/mihomo
resources/*/mihomo.exe

# CI 原生验收下载的候选工件（native-* jobs 下载 release-* artifacts 到此处）
/downloaded/

# Android local SDK, generated builds and private signing material
/android/local.properties
/android/.gradle/
/android/**/build/
/android/app/src/main/assets/public/
/android/app/src/androidTest/assets/headless/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/capacitor-cordova-android-plugins/
*.jks
*.keystore
/artifacts/

# Android engine outputs; pinned source manifest and owned overlay remain in Git.
# Publish the complete modified GPL source archive alongside each release APK.
android/app/libs/*.aar
android/app/libs/*.jar
android/app/libs/sing-box-android-source-*.tar.gz
android/app/libs/libbox-build.json
android/app/libs/*-sources.jar
android/app/src/main/assets/licenses/

# Isolated native validation builds
/dist-validation*/
/dist-native-candidate/

/android/app/src/main/assets/headless/

# Enterprise engine generated pinned source and binaries
/enterprise-runtime/.upstream/
resources/*/enterprise-runtime*
# OpenConnect 引擎及其 Homebrew 依赖库（由 build:enterprise 在打包机上现编现打）
resources/*/openconnect
resources/*/libs/
resources/**/openconnect-auth

# Local-only development records: not part of the open-source repository.
# Verification reports, measurement data, license provenance notes and
# implementation logs live outside Git; only specs and technical docs ship.
/docs/验证报告.md
/docs/验证数据/
/docs/资源占用实测-*.md
/docs/诊断/
/docs/历史来源/
/docs/规范/前端实现替换记录.md
/docs/后端修复.md
/docs/依赖升级.md
/docs/前端改造.md
/docs/维护手册.md
/NOTICE.md
