{
  "name": "shadowvpn-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "build:ui": "node scripts/run-runtime.mjs build-ui",
    "check": "node scripts/client-checks.mjs",
    "check:affected": "node scripts/client-checks.mjs --affected",
    "check:staged": "node scripts/client-checks.mjs --staged",
    "check:build": "node scripts/client-checks.mjs --phase build",
    "check:ui": "node scripts/client-checks.mjs --phase ui",
    "lint": "node scripts/client-checks.mjs --phase static",
    "lint:design": "node --test scripts/client-ui.test.mjs && node scripts/check-client-ui.mjs --project . --source src --source update-popup && node scripts/generate-client-tokens.mjs --check",
    "lint:eslint": "eslint src update-popup --max-warnings 0",
    "lint:i18n": "node --test scripts/client-i18n.unit.test.mjs && node scripts/check-client-i18n.mjs",
    "lint:dependency-builds": "node ./scripts/check-ignored-builds.mjs && node scripts/check-runtime-patches.mjs && node --test scripts/logviewer-runtime.test.mjs",
    "i18n:prune": "node scripts/check-client-i18n.mjs --prune",
    "preview": "vite preview",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:ui": "pnpm build:ui && node scripts/run-runtime.mjs ui",
    "test:ui:full": "pnpm build:ui && node scripts/run-runtime.mjs ui-full",
    "typecheck": "tsc -b --pretty false",
    "check:static": "node scripts/client-checks.mjs --phase static",
    "check:client": "node --test scripts/check-expanded.test.mjs && node scripts/check-expanded.mjs --project . --source src/pages --source src/components/vpn && pnpm check:client:time",
    "check:client:time": "node --test scripts/check-client-time.test.mjs && node scripts/check-client-time.mjs --project . --source src/pages --source src/components/vpn --source src/utils"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@capacitor/core": "8.5.3",
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/collision": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@melloware/react-logviewer": "6.6.0",
    "@monaco-editor/react": "4.7.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@sinonjs/text-encoding": "0.7.3",
    "abort-controller": "3.0.0",
    "antd": "6.6.5",
    "core-js-pure": "3.50.0",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "i18next": "26.4.2",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "postcss": "8.5.28",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  }
}
