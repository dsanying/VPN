{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "isolatedModules": false,
    "types": [
      "jest",
      "node"
    ],
    "module": "Preserve",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/__tests__/**/*.ts",
    "src/**/*.test.ts",
    "web/src/**/__tests__/**/*.ts",
    "web/src/global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
